      "id": "pico-unified-current",
      "displayName": "Pico 2 W Controller Bridge",
      "version": "0.2.0-preview.1",
      "description": "预览固件：四种 USB 输出、独立物理输入映射、真实源帧遥测与唤醒回连。实机回归待完成。",
      "boardIds": [
        "pico-2-w"
      ],
      "flashMethod": "PicoUf2",
      "artifactRelativePath": "artifacts/controllerbridge-pico2w-unified-0.2.0-preview.1.uf2",
      "flashHint": "按住 BOOTSEL 连接真正的 Pico 2 W 接收器，将 UF2 写入其启动盘；不要误选调试串口桥。"
    }
  ],
  "usbRoles": [
    {
      "role": "DualSense",
      "displayName": "DualSense",
      "description": "Sony HID、音频与触觉",
      "command": "role set ds5"
    },
    {
      "role": "DualSenseEdge",
      "displayName": "DualSense Edge",
      "description": "Sony Edge HID",
      "command": "role set dse"
    },
    {
      "role": "Xbox",
      "displayName": "XInput",
      "description": "XUSB 与独立管理 HID；测试 USB ID",
      "command": "role set xbox"
    },
    {
      "role": "NintendoNs2Pro",
      "displayName": "Nintendo NS2Pro",
      "description": "Nintendo HID",
      "command": "role set ns2pro"
    }
  ],
  "inputSources": [
    {
      "preference": "Auto",
      "displayName": "自动选择",
      "description": "优先使用已连接控制器",
      "command": "input set auto"
    },
    {
      "preference": "DualSense",
      "displayName": "仅使用 DualSense",
      "description": "Bluetooth Classic HID",
      "command": "input set ds5"
    },
    {
      "preference": "NintendoNs2Pro",
      "displayName": "仅使用 NS2Pro",
      "description": "Bluetooth LE",
      "command": "input set ns2pro"
    }
  ],
  "wirelessControllers": [
    {
      "id": "ds5",
      "displayName": "DualSense / DualSense Edge",
      "transportLabel": "Bluetooth Classic",
      "pairCommand": "ds5 pair",
      "connectCommand": "ds5 reconnect",
      "disconnectCommand": "ds5 disconnect",
      "forgetCommand": "ds5 forget"
    },
    {
      "id": "ns2",
      "displayName": "Nintendo NS2Pro",
      "transportLabel": "Bluetooth LE",
      "pairCommand": "ns2 pair",
      "connectCommand": "ns2 reconnect",
      "disconnectCommand": "ns2 disconnect",
      "forgetCommand": "ns2 forget"
    }
  ],
  "statusCommands": [
    "status",
    "usb status"
  ],
  "selfTestCommands": [
    "status",
    "usb status",
    "input status",
    "motion status",
    "ds5 status"
  ],
  "primaryStatusCommand": "status",
  "inputStatusCommand": "input status",
  "saveSettingsCommand": "settings save",
  "settingsCommandTemplates": [
    "rumble tune {rumbleScalePercent} {rumbleHoldMs} {rumbleTickMs} {rumbleStopPackets}",
    "usb rate {reportRateHz}",
    "usb raw {usbRaw}",
    "web parse {liveParsing}"
  ],
  "rumbleCommandTemplate": "rumble test {target}",
  "operations": {
    "mapping.read": {
      "transport": "ManagerCommand",
      "request": "mapping get {profile}"
    },
    "mapping.set": {
      "transport": "ManagerCommand",
      "request": "mapping set {profile} {target} {source}"
    },
    "mapping.reset": {
      "transport": "ManagerCommand",
      "request": "mapping reset {profile}"
    },
    "mapping.save": {
      "transport": "ManagerCommand",
      "request": "mapping save {profile}"
    },
    "settings.reset": {
      "transport": "ManagerCommand",
      "request": "settings reset"
    },
    "system.bootloader": {
      "transport": "ManagerCommand",
      "request": "bootsel"
    },
    "settings.save": {
      "transport": "ManagerCommand",
      "request": "settings save"
    },
    "settings.read": {
      "transport": "ManagerCommand",
      "request": "settings"
    },
    "system.reboot": {
      "transport": "ManagerCommand",
      "request": "reboot"
    }
  },
  "pages": [
    {
      "id": "pico-ds5-mapping",
      "label": "DualSense / DualSense Edge 映射",
      "description": "按输入手柄保存，适用于该手柄的所有 USB 输出身份。",
      "icon": "Game",
      "sections": [
        {
          "id": "ds5-buttons",
          "label": "按键映射",
          "controls": [
            {
              "id": "pico-ds5-button-map",
              "type": "MappingEditor",
              "label": "DualSense / DualSense Edge 按键来源",
              "binding": "/entries",
              "mappingProfile": "ds5",
              "sourceCatalog": "controller.inputControls",
              "targetCatalog": "bridge.outputControls",
              "readAction": "mapping.read",
              "applyAction": "mapping.set",
              "resetAction": "mapping.reset",
              "saveAction": "mapping.save"
            }
          ]
        }
      ]
    },
    {
      "id": "pico-ns2pro-mapping",
