              "binding": "/entries",
              "mappingProfile": "ns2pro",
              "sourceCatalog": "controller.inputControls",
              "targetCatalog": "bridge.outputControls",
              "readAction": "mapping.read",
              "applyAction": "mapping.set",
              "resetAction": "mapping.reset",
              "saveAction": "mapping.save"
            }
          ]
        }
      ]
    },
    {
      "id": "pico-recovery",
      "label": "配置与恢复",
      "description": "先保存需要保留的配置。恢复默认不会改变固件；进入 BOOTSEL 后 USB 将断开，可通过 UF2 更新。",
      "icon": "Settings",
      "sections": [
        {
          "id": "pico-settings",
          "label": "配置",
          "controls": [
            {
              "id": "pico-read-settings",
              "type": "ActionButton",
              "label": "读取配置",
              "applyAction": "settings.read"
            },
            {
              "id": "pico-save-settings",
              "type": "ActionButton",
              "label": "保存配置",
              "applyAction": "settings.save"
            },
            {
              "id": "pico-reset-settings",
              "type": "ActionButton",
              "label": "恢复默认配置",
              "applyAction": "settings.reset"
            }
          ]
        },
        {
          "id": "pico-system",
          "label": "接收器",
          "controls": [
            {
              "id": "pico-reboot",
              "type": "ActionButton",
              "label": "重启接收器",
              "applyAction": "system.reboot"
            },
            {
              "id": "pico-bootsel",
              "type": "ActionButton",
              "label": "进入 BOOTSEL 更新模式",
              "applyAction": "system.bootloader"
            }
          ]
        }
      ]
    }
